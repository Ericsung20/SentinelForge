<!--
  SentinelForge custom detections (rule IDs 100100-100199).
  Deployed to /var/ossec/etc/rules/ in the manager by detections/wazuh/deploy.sh.
  Each rule is documented in detections/<name>.md.
-->
<group name="sentinelforge,">

  <!-- Defender 5007 is a generic "configuration changed" event. The built-in rule 62154 gives it level 5,
       the same as Defender's routine internal updates (e.g. CoreService\WdConfigHash), so an attacker's
       exclusion blends in. Raise it when the new value is an exclusion. Wazuh stores the registry path
       with escaped backslashes, hence \\+ instead of a single \\. -->
  <rule id="100100" level="10">
    <if_sid>62154</if_sid>
    <field name="win.eventdata.new Value" type="pcre2">(?i)Windows Defender\\+Exclusions\\+(Paths|Extensions|Processes|IpAddresses)\\+</field>
    <description>Windows Defender exclusion added: $(win.eventdata.new Value)</description>
    <mitre>
      <id>T1562.001</id>
    </mitre>
    <group>windows,windows_defender,defense_evasion,</group>
  </rule>

  <!-- PowerShell started with a command line that decodes Base64 and runs the result (iex / Invoke-Expression),
       the fileless pattern behind Poweliks/Powessere-style malware. Built-in rule 67027 rates every 4688 at
       level 3. Works on the command line alone, so it fires even when Defender blocks the payload. -->
  <rule id="100110" level="10">
    <if_sid>67027</if_sid>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\(powershell|pwsh)\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)^(?=.*FromBase64String)(?=.*(\biex\b|Invoke-Expression))</field>
    <description>PowerShell decoded Base64 and executed it in memory (user $(win.eventdata.subjectUserName))</description>
    <mitre>
      <id>T1059.001</id>
      <id>T1027</id>
    </mitre>
    <group>windows,powershell,execution,defense_evasion,</group>
  </rule>

  <!-- Scheduled task created that runs a script interpreter at boot or logon: classic persistence.
       Built-in rule 60228 rates every 4698 at level 4. The task XML in taskContent is HTML-escaped
       (&lt;Command&gt;cmd.exe&lt;/Command&gt;). The pattern avoids & and < so it survives this XML file:
       ".gt;" and ".lt;" stand for the escaped brackets. -->
  <rule id="100120" level="10">
    <if_sid>60228</if_sid>
    <field name="win.eventdata.taskContent" type="pcre2">(?i)^(?=.*(Boot|Logon)Trigger)(?=.*Command.gt;[^;]*\b(cmd|powershell|pwsh|wscript|cscript|mshta|rundll32|regsvr32)(\.exe)?.lt;/Command)</field>
    <description>Scheduled task $(win.eventdata.taskName) runs a script interpreter at boot or logon (created by $(win.eventdata.subjectUserName))</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
    <group>windows,scheduled_task,persistence,</group>
  </rule>

  <!-- Run/RunOnce key written by a script interpreter. Built-in 92300 matches every Run-key write at
       level 0 and only its child 92302 alerts, and only when the writer is reg.exe. The same value
       written with PowerShell (Set-ItemProperty) produced no alert at all. -->
  <rule id="100130" level="10">
    <if_sid>92300</if_sid>
    <field name="win.eventdata.image" type="pcre2">(?i)\\(powershell|pwsh|wscript|cscript|mshta|rundll32)\.exe$</field>
    <description>Run key $(win.eventdata.targetObject) set by script interpreter $(win.eventdata.image): $(win.eventdata.details)</description>
    <mitre>
      <id>T1547.001</id>
    </mitre>
    <group>windows,registry,persistence,</group>
  </rule>

  <!-- Account discovery, two rules. 100140 tags each local account enumeration command (Security 4688);
       one command alone is routine admin work, so it stays at level 3. 100141 correlates: three or more
       from the same user within 60 seconds is the post-compromise recon pattern.
       net1.exe is deliberately not matched: "net user" starts net.exe and then net1.exe, which would
       count every command twice. Plain "whoami" is excluded too; Invoke-AtomicTest runs it itself. -->
  <rule id="100140" level="3">
    <if_sid>67027</if_sid>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)(\bnet\s+(user|localgroup|group|accounts)\b|\bcmdkey(\.exe)?\s+/list|\bquser\b|\bquery\s+user\b|\bwhoami\b.*\s/(all|groups|priv))</field>
    <!-- Phase 6 tuning (2026-10-28): the Wazuh agent enumerates local users as part of its own
         inventory, running `net user` as the computer account (parent wazuh-agent.exe). That is the
         false positive documented in INC-002. Exclude only that parent, so genuine SYSTEM-context
         discovery from any other process still alerts (an allowlist, not a blanket SYSTEM exclusion). -->
    <field name="win.eventdata.parentProcessName" negate="yes" type="pcre2">(?i)\\wazuh-agent\.exe$</field>
    <description>Account discovery command by $(win.eventdata.subjectUserName): $(win.eventdata.commandLine)</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
    <group>windows,discovery,</group>
  </rule>

  <rule id="100141" level="10" frequency="3" timeframe="60">
    <if_matched_sid>100140</if_matched_sid>
    <same_field>win.eventdata.subjectUserName</same_field>
    <description>Account discovery burst: 3 or more enumeration commands within 60 seconds by $(win.eventdata.subjectUserName)</description>
    <mitre>
      <id>T1087.001</id>
    </mitre>
    <group>windows,discovery,</group>
  </rule>

</group>
